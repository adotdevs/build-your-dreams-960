MONGODB_URI=mongodb://127.0.0.1:27017/cryptogen
AUTH_SECRET=replace-with-a-long-random-string
# Private Vercel Blob store. Leave empty locally to keep files in the uploads folder.
BLOB_READ_WRITE_TOKEN=
SEED_OWNER_EMAIL=owner@cryptogen.internal
SEED_OWNER_PASSWORD=Owner12345!
# Optional SMTP fallback defaults (can also be configured in Platform Settings)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Cryptogen
SMTP_FROM_EMAIL=
APP_URL=http://localhost:3000

